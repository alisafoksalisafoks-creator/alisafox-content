[Unit]
Description=AlisaFox prompt engineer Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/promt-bot
EnvironmentFile=/opt/promt-bot/.env
Environment=PROMT_BOT_DATA=/var/lib/promt-bot
ExecStart=/opt/promt-bot/.venv/bin/python -m promt_bot.app
# упал — перезапуск через 10 секунд, без ограничения числа попыток
Restart=always
RestartSec=10
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
