# Скопируйте в /opt/yougile-bot/.env и впишите ключи. Файл .env никому не пересылайте и не загружайте на GitHub.
# Токен бота: @BotFather → /newbot → API Token
TELEGRAM_YOUGILE_BOT_TOKEN=
# Ключ YouGile: создаёт администратор компании «ИП Попова» (инструкция в README). Задачи от бота будут от его имени.
YOUGILE_API_KEY=
# Ключ Claude для кнопки «Ввод» (install.sh сам возьмёт его у бота «Промт инженер», если он есть)
ANTHROPIC_API_KEY=
YG_BOT_MODEL=claude-sonnet-5-5
# Telegram ID владельца и, через запятую, кому ещё открыть бота
YG_BOT_OWNER=883197778
YG_BOT_USERS=
# Часовой пояс отчётов
YG_TZ=Asia/Yekaterinburg
# Кого не показывать кнопками (первое слово имени в YouGile)
YG_EXCLUDE=Алина,Вера,Яна,Лана,Дана,Андрей,Менеджер,Дарина,Константин
# Адрес для событий YouGile: http://IP-сервера:8090/yougile/<любая длинная случайная строка>
# Пусто — бот работает без событий: переносы и сообщения видны только через историю задач (медленнее, неполно)
YG_WEBHOOK_URL=
YG_WEBHOOK_PORT=8090
# Расписание: утренний отчёт (итоги прошлого рабочего дня, просрочки, по понедельникам — неделя),
# сигнал «нет действий в YouGile», рабочие дни (0 — пн … 6 — вс)
YG_MORNING=09:00
YG_IDLE_CHECK=11:00
YG_WORKDAYS=0,1,2,3,4
# Голосовой «Ввод»: модель расшифровки (tiny, base, small, medium). small — баланс скорости и качества
YG_WHISPER_MODEL=small
