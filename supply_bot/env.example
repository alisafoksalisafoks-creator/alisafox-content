# Скопируйте в /etc/supply-bot.env и заполните на сервере. Сюда и в git ключи не вписывать.
TELEGRAM_SUPPLY_BOT_TOKEN=   # токен НОВОГО бота от @BotFather (не @audit_alisafox_bot)
SUPPLY_BOT_CHATS=            # chat id через запятую; пусто — бот никому не отвечает и только подскажет chat id
SUPPLY_BOT_ADMINS=           # кто управляет доступом кнопкой «Доступ»; пусто — первый id из SUPPLY_BOT_CHATS
OZON_CLIENT_ID=
OZON_API_KEY=                # ключ Ozon Seller с правами только на чтение
MOYSKLAD_TOKEN=              # токен «Моего склада», роль только чтение
GOOGLE_SA_JSON=/opt/supply-bot/sa.json   # ключ сервисного аккаунта Google; таблицам дать доступ «Читатель»
SUPPLY_BOT_DATA=/var/lib/supply-bot      # кеш заказов, снимок данных, ручные правки, season.tsv
# MS_STORE=1. Основной склад
