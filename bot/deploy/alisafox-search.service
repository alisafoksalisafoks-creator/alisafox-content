[Unit]
Description=AlisaFox Telegram bot: positions and keywords
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/alisafox-search
EnvironmentFile=/opt/alisafox-search/.env
Environment=BOT_MODE=search
ExecStart=/opt/alisafox-search/.venv/bin/python -m bot.app
# упал — перезапуск через 10 секунд, без ограничения числа попыток
Restart=always
RestartSec=10
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
