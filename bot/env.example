# Скопируйте этот файл в .env (в корень папки alisafox-content) и впишите свои ключи.
# Файл .env никому не пересылайте и не загружайте на GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=
MOYSKLAD_TOKEN=
