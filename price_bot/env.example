# Скопируйте этот файл в .env (в корень папки /opt/price-bot) и впишите ключи.
# Файл .env никому не пересылайте и не загружайте на GitHub.
# Токен бота: @BotFather → /newbot → API Token (нужен новый бот, не токен промпт-бота)
TELEGRAM_PRICE_BOT_TOKEN=
# Ozon Seller API: личный кабинет → Настройки → Seller API. Ключ с доступом к ценам, акциям и аналитике.
OZON_CLIENT_ID=
OZON_API_KEY=
# Telegram ID владельца: только он видит кнопку «Доступ»
PRICE_BOT_OWNER=883197778
# TrueStats (ЧП на 1 шт и ДРР): адрес MCP-сервера и API-ключ из кабинета ТС
TRUESTATS_MCP_URL=
TRUESTATS_API_KEY=
